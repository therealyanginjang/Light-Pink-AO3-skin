p.kudos {
  background: none;
}

div:has(> p.kudos)::before {
  content: "";
  height: 55px;
  width: 55px;
  position: absolute;
  background-image: url("https://i.imgur.com/DlypPfC.png");
  background-size: cover;
  filter: brightness(0) saturate(100%) invert(59%) sepia(15%) saturate(954%) hue-rotate(268deg) brightness(87%) contrast(92%);
}

dl.stats dd:nth-of-type(1)::before {
  background: url(https://i.imgur.com/BB6okS9.png);
}

dl.stats dd:nth-of-type(2)::before {
  background: url(https://i.imgur.com/m5tUnS1.png);
}

dl.stats dd.language::before {
  display: none !important;
}

dl.stats dd.kudos::before {
  background: url(https://i.imgur.com/YnfgLpZ.png);
}

dl.stats dd.words::before {
  background: url(https://i.imgur.com/BeEs9Uj.png);
}

dl.stats dd.chapters::before {
  background: url(https://i.imgur.com/14TtfSu.png);
}

dl.stats dd.comments::before {
  background: url(https://i.imgur.com/R160dOA.png);
}

dl.stats dd.bookmarks::before,
dl.stats dd a[href$=bookmarks]::before {
  background: url(https://i.imgur.com/vXrAKO7.png);
}

.stats dd.inspired::before {
  background: url(https://i.imgur.com/DSBf66G.png);
}

dl.stats dd.hits::before {
  background: url(https://i.imgur.com/TuKCemF.png);
}

dl.stats dd.collections::before {
  background: url(https://i.imgur.com/77i8r9E.png);
  width: 14px;
  height: 14px;
  content: " ";
  background-size: 14px 14px;
  margin-right: 2px;
}

dl.work dl.stats dd.published::before {
  background: url(https://i.imgur.com/1XLvyI7.png);
  display: inline-block;
  width: 14px;
  height: 14px;
  content: " ";
  background-size: 14px 14px;
  margin-right: 5px;
  margin-left: 0px;
}

dl.work dl.stats dd.status::before {
  background: url(https://i.imgur.com/1XKoeed.png);
  display: inline-block;
  width: 14px;
  height: 14px;
  content: " ";
  background-size: 14px 14px;
  margin-right: 5px;
}

ul.statistics dl.stats dd.subscriptions::before {
  background: url(https://i.imgur.com/zq30PWg.png);
  display: inline-block;
  width: 14px;
  height: 14px;
  content: " ";
  background-size: 14px 14px;
  margin-right: 2px;
}

li.collection dl.stats dd a[href$=works]::before {
  background: url(https://i.imgur.com/m5tUnS1.png);
}

li.collection dl.stats dd a[href$=collections]::before {
  background: url(https://i.imgur.com/77i8r9E.png);
  display: inline-block;
  width: 14px;
  height: 14px;
  content: "";
  background-size: 14px 14px;
  margin-right: 5px;
}

li.collection dl.stats dd a[href$=bookmarks]::before {
  background: url(https://i.imgur.com/vXrAKO7.png);
}

li.collection dl.stats dd a[href$=words]::before {
  background: url(https://i.imgur.com/BB6okS9.png);
}

li.collection dl.stats dd a[href$=fandoms]::before {
  background: url(https://i.imgur.com/5DDAJFC.png);
}

ul.statistics dl.stats dd::before,
li.work dl.stats dd::before,
li.bookmark dl.stats dd::before,
dl.work dl.stats dd::before,
li.collection dl.stats dd a[href$=collections]::before,
li.collection dl.stats dd a[href$=works]::before,
li.collection dl.stats dd a[href$=bookmarks]::before,
li.collection dl.stats dd a[href$=fandoms]::before,
li.series dl.stats dd:not(.language):not(.words):not(.chapters):not(.collections):not(.comments):not(.kudos):not(.bookmarks):not(.hits):not(.published):not(.subscriptions):nth-of-type(1)::before,
li:not(.collection) dl.stats dd:not(.language):not(.words):not(.chapters):not(.collections):not(.comments):not(.kudos):not(.bookmarks):not(.hits):not(.published):not(.subscriptions):nth-of-type(2)::before,
dl.stats dd:not(.bookmarks) a[href$=bookmarks]::before {
  display: inline-block;
  width: 14px;
  height: 14px;
  content: " ";
  background-size: 14px 14px;
  margin-right: 2px;
  filter: brightness(0) saturate(100%) invert(59%) sepia(15%) saturate(954%) hue-rotate(268deg) brightness(87%) contrast(92%);
}

li.warnings a.tag:hover {
